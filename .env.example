# GraphGuard AI Configuration

# FalkorDB Connection
FALKORDB_HOST=your-falkordb-host.cloud
FALKORDB_PORT=6379
FALKORDB_USERNAME=falkordb
FALKORDB_PASSWORD=your-falkordb-password
FALKORDB_GRAPH_NAME=graphguard
FALKORDB_SSL=false

# Backend Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development

# LLM Provider Configuration (Groq recommended)
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b

# Authentication & Security Configuration
AUTH_SECRET=your-64-character-jwt-auth-secret
FRONTEND_URL=http://127.0.0.1:5173,http://localhost:5173

# Bootstrap Initial Users Credentials (Password must be strong)
ADMIN_EMAIL=admin@graphguard.ai
ADMIN_PASSWORD=your-secure-admin-password

ANALYST_EMAIL=analyst@graphguard.ai
ANALYST_PASSWORD=your-secure-analyst-password

REVIEWER_EMAIL=reviewer@graphguard.ai
REVIEWER_PASSWORD=your-secure-reviewer-password

VIEWER_EMAIL=viewer@graphguard.ai
VIEWER_PASSWORD=your-secure-viewer-password
